{
  // Typechecks the TEST tree alongside src (ARCHITECTURE → "Build and test
  // resolution"). Extends the base directly rather than tsconfig.json, so the
  // app config's `include` does not narrow the test tree out — the base
  // carries the `@dagsocial/*` paths this package's imports from `types`,
  // `node-reads` and `nipopow-client` resolve under. No `types` field: every
  // test imports from 'vitest' explicitly rather than leaning on globals.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": []
  },
  "include": ["src", "test"]
}
