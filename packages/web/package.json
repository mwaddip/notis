{
  "name": "@dagsocial/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./mesh": {
      "types": "./dist-mesh/index.d.ts",
      "import": "./dist-mesh/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsup src/mesh/index.ts --format esm --dts --out-dir dist-mesh",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.browser.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dagsocial/net": "workspace:*",
    "@dagsocial/nipopow": "workspace:*",
    "@dagsocial/nipopow-client": "workspace:*",
    "@dagsocial/node-reads": "workspace:*",
    "@dagsocial/types": "workspace:*",
    "@dagsocial/validation": "workspace:*",
    "@libp2p/gossipsub": "17.2.1",
    "@libp2p/interface": "3.4.0",
    "@libp2p/peer-id": "6.0.18",
    "@libp2p/utils": "7.4.5",
    "@multiformats/multiaddr": "13.0.3",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "libp2p": "3.5.1"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.13.2",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vitest": "^1.6.0",
    "web-ext": "10.6.0"
  }
}
