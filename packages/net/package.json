{
  "name": "@dagsocial/net",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "types": "./dist/browser.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/browser.ts --format esm --dts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.browser.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dagsocial/node-reads": "workspace:*",
    "@dagsocial/types": "workspace:*",
    "@dagsocial/validation": "workspace:*",
    "@dagsocial/wire": "workspace:*",
    "@libp2p/autonat-v2": "2.1.8",
    "@libp2p/circuit-relay-v2": "4.2.17",
    "@libp2p/crypto": "5.2.0",
    "@libp2p/dcutr": "3.0.32",
    "@libp2p/gossipsub": "17.2.1",
    "@libp2p/http": "2.0.6",
    "@libp2p/http-fetch": "4.0.4",
    "@libp2p/http-utils": "2.0.6",
    "@libp2p/identify": "4.1.18",
    "@libp2p/interface": "3.4.0",
    "@libp2p/kad-dht": "16.4.9",
    "@libp2p/keychain": "6.1.10",
    "@libp2p/noise": "17.0.7",
    "@libp2p/peer-id": "6.0.18",
    "@libp2p/ping": "3.1.17",
    "@libp2p/tcp": "11.0.32",
    "@libp2p/webrtc": "7.0.2",
    "@libp2p/websockets": "10.1.25",
    "@libp2p/yamux": "8.0.7",
    "@multiformats/multiaddr": "13.0.3",
    "acme-client": "5.4.0",
    "datastore-fs": "12.0.1",
    "interface-datastore": "10.0.1",
    "libp2p": "3.5.1"
  },
  "devDependencies": {
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "@peculiar/x509": "2.2.0",
    "@types/node": "^24.19.2",
    "datastore-core": "12.0.1",
    "it-length-prefixed": "11.0.1",
    "reflect-metadata": "0.2.2",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
