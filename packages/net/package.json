{
  "name": "@dagsocial/net",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dagsocial/types": "workspace:*",
    "@dagsocial/validation": "workspace:*",
    "@dagsocial/wire": "workspace:*",
    "@libp2p/gossipsub": "^17.0.0",
    "@libp2p/identify": "^4.0.0",
    "@libp2p/interface": "^3.4.0",
    "@libp2p/noise": "^17.0.0",
    "@libp2p/ping": "^3.0.0",
    "@libp2p/tcp": "^11.0.0",
    "@libp2p/yamux": "^8.0.0",
    "@multiformats/multiaddr": "^13.0.0",
    "libp2p": "^3.5.1"
  },
  "devDependencies": {
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
