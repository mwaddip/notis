{
  "name": "@dagsocial/node",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts src/miner-consolidate.ts --format esm --dts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:slow": "vitest run -c vitest.slow.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dagsocial/consensus": "workspace:*",
    "@dagsocial/net": "workspace:*",
    "@dagsocial/nipopow": "workspace:*",
    "@dagsocial/types": "workspace:*",
    "@dagsocial/validation": "workspace:*",
    "@dagsocial/avltree": "workspace:*",
    "@dagsocial/node-reads": "workspace:*",
    "better-sqlite3": "^13.0.0",
    "cbor-x": "^1.6.0",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@libp2p/interface": "3.4.0",
    "@multiformats/multiaddr": "13.0.3",
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^4.17.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "libp2p": "3.5.1",
    "supertest": "^7.2.2",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
