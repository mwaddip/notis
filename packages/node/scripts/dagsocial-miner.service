[Unit]
Description=DAGsocial miner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment="NODE_URL=https://your-node.example.com/testnet/api"
Environment="MINER_PCT=25"
Environment="MINING_SECRET=CHANGE_ME"
# `gen-miner-key.mjs <path>` writes the file MINER_KEY_PATH names
# (MINING_INTERFACE → Consolidation).
Environment="MINER_KEY_PATH=/var/lib/dagsocial/miner-key.json"
ExecStart=/usr/bin/node /opt/dagsocial/packages/node/scripts/miner.mjs
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
