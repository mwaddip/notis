    "lan1": {
      "_comment": "A node on the browser's own network. s7 step 4 cuts lan1's p2p port from every honest node and pairs it with `lan1-peer` as its one Active peer, so a MINER_PCT=1 miner inside lan1's namespace keeps producing templates after the cut (MINING_INTERFACE → The peer-readiness gate). `node.role` is `miner` so `/mining` is served; steps 1-3 and 5 do not launch the miner script, so lan1 serves blocks for them as any `server` node would.",
      "role": "private",
      "nat": "endpoint-independent",
      "parent": "natC",
      "addr": "10.103.0.21",
      "veth": "l1",
      "mesh": {
        "role": "private",
