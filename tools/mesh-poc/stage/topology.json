    "hostile-fork": {
      "_comment": "A hostile mesh node that syncs the honest chain from pub1 and is then cut at Phase 8b, paired with hostile-fork-peer as its one Active peer so a MINER_PCT=1 miner inside its namespace keeps producing templates (MINING_INTERFACE → The peer-readiness gate — a miner only serves a template while the node holds at least one Active peer). s6 step 1 reaches this node as a known node for the second session; the first session seats the kept proof on the honest nodes, the second finds the fork node behind on a lighter fork of the honest chain.",
      "role": "hostile",
      "nat": "none",
      "addr": "11.100.0.35",
      "veth": "hf",
      "mesh": {
        "role": "public",
        "webrtcPort": 4001,
        "tcpPort": 4002
      },
      "node": {
        "httpPort": 3100,
        "p2pPort": 9100,
        "role": "miner"
      }
    },
    "hostile-fork-peer": {
      "_comment": "The one Active peer `hostile-fork` keeps after the cut (MINING_INTERFACE → The peer-readiness gate). Synced from pub1 at boot like `hostile-fork`; Phase 8b cuts both with each other as the accept-partner, so neither sees honest blocks but each keeps the other as a peer. No miner runs on this host — `hostile-fork`'s miner is the one that grows the fork.",
      "role": "hostile",
      "nat": "none",
      "addr": "11.100.0.36",
      "veth": "hfp",
      "mesh": {
        "role": "public",
        "webrtcPort": 4001,
        "tcpPort": 4002
      },
      "node": {
        "httpPort": 3100,
        "p2pPort": 9100,
        "role": "server"
      }
    },
