      "nat": "none",
      "addr": "11.100.0.11",
      "veth": "p1",
      "mesh": {
        "role": "public",
        "webrtcPort": 4001,
        "tcpPort": 4002,
        "stunPort": 3478,
        "wss": {
          "port": 443,
          "acmeChallengePort": 5002
        }
      },
      "node": {
        "httpPort": 3100,
        "p2pPort": 9100,
        "role": "miner"
      }
    },
